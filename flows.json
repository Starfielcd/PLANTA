    {
        "id": "e30856414dee5906",
        "type": "function",
        "z": "81836be24ab952ff",
        "name": "Validar WS y normalizar evento",
        "func": "let e=msg.payload;if(typeof e==='string'){try{e=JSON.parse(e)}catch(err){msg.error={message:'Evento WS no es JSON',source:'WS'};return [null,msg]}}const key=env.get('INTERNAL_API_KEY');if(!e||!key||e.api_key!==key){node.warn('WS rechazado: API Key inválida');return null;}delete e.api_key;msg.payload=e;msg.request_id=e.request_id||('evt-'+Date.now()+'-'+Math.random().toString(36).slice(2,8));msg.topic='event.'+(e.type||'unknown');msg.received_at=new Date().toISOString();return msg;",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
